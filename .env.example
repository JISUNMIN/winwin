# Web
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Android Studio emulator
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# Real device on same Wi-Fi
# EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:8080

# Development-only quick role switch on auth/home screens
# EXPO_PUBLIC_ENABLE_DEV_ROLE_SWITCH=true

# Development-only fallback mock/example data when API fails
# EXPO_PUBLIC_ENABLE_DEV_FALLBACK_DATA=true

# Production example
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com
# EXPO_PUBLIC_ENABLE_DEV_ROLE_SWITCH=false
# EXPO_PUBLIC_ENABLE_DEV_FALLBACK_DATA=false

# Play Store / EAS build note
# Production Android builds use the value above at build time.
